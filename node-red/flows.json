    {
        "id": "ui_card_asig_multi",
        "type": "ui_template",
        "z": "tab_layout_split_final",
        "group": "grp_flota_asignaciones",
        "name": "Historial de Asignaciones",
        "order": 1,
        "width": "5",
        "height": "4",
        "format": "<div style=\"background-color: #faf8f5; border: 1px solid #90caf9; border-radius: 4px; padding: 8px; font-family: Arial, sans-serif; font-size: 11px; color: #333; height: 130px; overflow-y: auto;\">\n  <div style=\"font-weight: bold; color: #1565c0; border-bottom: 1px solid #bbdefb; padding-bottom: 4px; margin-bottom: 6px;\">\n    Historial de la central\n  </div>\n  <div ng-if=\"!eventos.length\" style=\"color: #777; font-style: italic; padding-top: 25px; text-align: center;\">\n    Sin órdenes recibidas\n  </div>\n  <div ng-repeat=\"e in eventos track by $index\" style=\"padding: 3px 0; border-bottom: 1px dotted #e0e0e0;\">\n    <span style=\"color: #666;\">[{{e.hora}}]</span>\n    <span ng-if=\"e.tipo === 'ERROR'\" style=\"color: #c62828; font-weight: bold;\">(Aviso)</span>\n    <span ng-if=\"e.tipo !== 'ERROR'\" style=\"color: #2e7d32; font-weight: bold;\">(OK)</span>\n    <span>{{e.texto}}</span>\n  </div>\n</div>\n<script>\n(function(scope) {\n  scope.eventos = scope.eventos || [];\n  scope.$watch('msg', function(msg) {\n    if (msg && msg.payload) {\n      var d = msg.payload;\n      var texto = (typeof d === 'string') ? d : (d.mensaje || JSON.stringify(d));\n      var hora = new Date().toLocaleTimeString();\n      var tipo = d.tipo || 'OK';\n      scope.eventos.unshift({ hora: hora, texto: texto, tipo: tipo });\n      if (scope.eventos.length > 20) scope.eventos.pop();\n    }\n  });\n})(scope);\n</script>",
