    {
        "id": "func_multi_cos",
        "type": "function",
        "z": "tab_layout_split_final",
        "name": "Procesar Cosechadora",
        "func": "let d = msg.payload;\nlet id = d.id || 1;\nlet pos = Number(d.pos) || 100;\nlet carga = (d.carga !== undefined) ? Number(d.carga) : 0;\nlet color = (carga >= 80 || d.solicita_descarga === 1) ? 'red' : 'green';\n\nlet latBase = 40.4168;\nlet lonBase = -3.7038;\nlet lat = d.lat || (latBase + (pos * 0.00003));\nlet lon = d.lon || (lonBase + (pos * 0.00004));\n\nlet msgMapa = {\n    payload: {\n        name: \"Cosechadora \" + id,\n        lat: lat,\n        lon: lon,\n        icon: \"circle\",\n        iconColor: color,\n        layer: \"Cosechadoras\",\n        tooltip: \"Cosechadora \" + id + \" | Tolva: \" + carga + \"% | Pos: \" + pos\n    }\n};\n\nlet msgCard = {\n    payload: {\n        id: id,\n        carga: carga,\n        pos: pos,\n        alerta: (color === 'red')\n    }\n};\n\nreturn [msgMapa, msgCard];",
        "outputs": 2,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 510,
        "y": 100,
        "wires": [
            [
                "nodo_worldmap_engine_multi"
            ],
            [
                "ui_card_cosechadoras_multi"
            ]
        ]
    },
    {
        "id": "ui_map_embed_box_multi",
        "type": "ui_template",
        "z": "tab_layout_split_final",
        "group": "grp_flota_mapa",
        "name": "Visor Mapa Izquierda",
        "order": 1,
        "width": "7",
        "height": "12",
        "format": "<div style=\"background-color: #faf8f5; border: 1px solid #90caf9; border-radius: 4px; padding: 8px; height: 100%; box-sizing: border-box;\">\n  <div style=\"font-size: 13px; font-weight: bold; color: #1565c0; margin-bottom: 6px; display: flex; justify-content: space-between;\">\n    <span>📍 Supervisión GPS de Parcela</span>\n    <span style=\"font-size: 11px;\">🟢 Cosechadora | 🔴 Alerta | ⚪ Camión</span>\n  </div>\n  <iframe src=\"/worldmap\" style=\"width: 100%; height: 500px; border: 1px solid #bbdefb; border-radius: 3px;\"></iframe>\n</div>",
        "storeOutMessages": true,
        "fwdInMessages": true,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
        "x": 770,
        "y": 60,
