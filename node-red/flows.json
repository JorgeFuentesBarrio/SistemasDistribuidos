    {
        "id": "func_multi_truck",
        "type": "function",
        "z": "tab_layout_split_final",
        "name": "Procesar Camión",
        "func": "let d = msg.payload;\nlet id = d.id || 1;\nlet pos = Number(d.pos) || 70;\nlet libre = (d.capacidad === 1);\n\nlet latBase = 40.4164;\nlet lonBase = -3.7032;\nlet lat = d.lat || (latBase + (pos * 0.00003));\nlet lon = d.lon || (lonBase + (pos * 0.00004));\n\nlet msgMapa = {\n    payload: {\n        name: \"Camión \" + id,\n        lat: lat,\n        lon: lon,\n        icon: \"circle\",\n        iconColor: \"grey\",\n        layer: \"Camiones\",\n        tooltip: \"Camión \" + id + \" | \" + (libre ? \"Disponible\" : \"En transporte\") + \" | Pos: \" + pos\n    }\n};\n\nlet msgCard = {\n    payload: {\n        id: id,\n        pos: pos,\n        libre: libre\n    }\n};\n\nreturn [msgMapa, msgCard];",
        "outputs": 2,
        "x": 510,
        "y": 200,
        "wires": [
            [
                "nodo_worldmap_engine_multi"
            ],
            [
                "ui_card_camiones_multi"
