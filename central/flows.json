    {
        "id": "func_multi_camiones",
        "type": "function",
        "z": "tab_layout_split_final",
        "name": "Procesar Camión",
        "func": "let d = msg.payload;\n\nif (typeof d === \"string\") {\n    try {\n        d = JSON.parse(d);\n    } catch (e) {\n        return null;\n    }\n}\n\nif (!d || d.lat === undefined || d.lon === undefined) {\n    return null;\n}\n\nlet id = d.id;\nlet lat = Number(d.lat);\nlet lon = Number(d.lon);\nlet libre = (Number(d.capacidad) === 1);\n\nlet msgMapa = {\n    payload: {\n        name: \"Camión \" + id,\n        lat: lat,\n        lon: lon,\n        icon: \"truck\",\n        iconColor: libre ? \"blue\" : \"orange\",\n        layer: \"Camiones\",\n        tooltip: \"Camión \" + id + \" | \" + (libre ? \"Disponible\" : \"En ruta / Ocupado\")\n    }\n};\n\nlet msgCard = {\n    payload: {\n        id: id,\n        lat: lat,\n        lon: lon,\n        libre: libre\n    }\n};\n\nreturn [msgMapa, msgCard];",
        "outputs": 2,
        "x": 570,
        "y": 380,
        "wires": [
            [
                "nodo_worldmap_engine_multi"
            ],
            [
                "ui_card_camiones_multi"
            ]
        ]
    },
