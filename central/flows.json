        "format": "<div style=\"background-color: #faf8f5; border: 1px solid #90caf9; border-radius: 4px; padding: 8px; height: 100%; box-sizing: border-box;\">\n  <div style=\"font-size: 13px; font-weight: bold; color: #1565c0; margin-bottom: 6px; display: flex; justify-content: space-between;\">\n    <span>📍 Supervisión GPS de Parcela</span>\n    <span style=\"font-size: 11px;\">🟢 Cosechando | 🔴 Pide vaciado | 🔵 Camión libre | 🟠 Ocupado</span>\n  </div>\n  <iframe src=\"/worldmap\" style=\"width: 100%; height: 500px; border: 1px solid #bbdefb; border-radius: 3px;\"></iframe>\n</div>",
