    {
        "id": "ui_card_cosechadoras_multi",
        "type": "ui_template",
        "z": "tab_layout_split_final",
        "group": "grp_flota_cosechadoras",
        "name": "Lista Flota Cosechadoras",
        "order": 1,
        "width": "5",
        "height": "4",
        "format": "<div style=\"background-color: #faf8f5; border: 1px solid #90caf9; border-radius: 4px; padding: 8px; font-family: Arial, sans-serif; font-size: 12px; color: #333; height: 130px; overflow-y: auto;\">\n  <div style=\"font-weight: bold; color: #1565c0; border-bottom: 1px solid #bbdefb; padding-bottom: 4px; margin-bottom: 6px; display: flex; justify-content: space-between;\">\n    <span>Flota de Cosechadoras</span>\n    <span>Activas: {{contar(cosechadoras)}}</span>\n  </div>\n  <div ng-if=\"!contar(cosechadoras)\" style=\"color: #777; font-style: italic; text-align: center; padding-top: 25px;\">\n    Sin datos de cosechadoras\n  </div>\n  <div ng-repeat=\"(id, c) in cosechadoras\" style=\"padding: 5px 0; border-bottom: 1px dotted #e0e0e0;\">\n    <div style=\"display: flex; justify-content: space-between; align-items: center;\">\n      <span><strong>Cosechadora #{{c.id}}</strong></span>\n      <span ng-if=\"c.alerta\" style=\"color: #c62828; font-weight: bold;\">Pide vaciado ({{c.carga}}%)</span>\n      <span ng-if=\"!c.alerta\" style=\"color: #2e7d32; font-weight: bold;\">Cosechando ({{c.carga}}%)</span>\n    </div>\n    <div style=\"background: #e0e0e0; border-radius: 3px; height: 6px; width: 100%; margin-top: 3px; overflow: hidden;\">\n      <div ng-style=\"{'width': c.carga + '%', 'background-color': c.alerta ? '#c62828' : '#2e7d32'}\" style=\"height: 100%; transition: width 0.4s;\"></div>\n    </div>\n  </div>\n</div>\n<script>\n(function(scope) {\n  scope.cosechadoras = {};\n  scope.contar = function(obj) { return Object.keys(obj || {}).length; };\n  scope.$watch('msg', function(msg) {\n    if (msg && msg.payload && msg.payload.id !== undefined) {\n      scope.cosechadoras[msg.payload.id] = msg.payload;\n    }\n  });\n})(scope);\n</script>",
        "storeOutMessages": true,
        "fwdInMessages": true,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
        "x": 870,
        "y": 300,
        "wires": [
            []
        ]
    },
    {
        "id": "ui_card_camiones_multi",
        "type": "ui_template",
        "z": "tab_layout_split_final",
        "group": "grp_flota_camiones",
        "name": "Lista Flota Camiones",
        "order": 1,
        "width": "5",
        "height": "4",
        "format": "<div style=\"background-color: #faf8f5; border: 1px solid #90caf9; border-radius: 4px; padding: 8px; font-family: Arial, sans-serif; font-size: 12px; color: #333; height: 130px; overflow-y: auto;\">\n  <div style=\"font-weight: bold; color: #1565c0; border-bottom: 1px solid #bbdefb; padding-bottom: 4px; margin-bottom: 6px; display: flex; justify-content: space-between;\">\n    <span>Flota de Camiones</span>\n    <span>Activos: {{contar(camiones)}}</span>\n  </div>\n  <div ng-if=\"!contar(camiones)\" style=\"color: #777; font-style: italic; text-align: center; padding-top: 25px;\">\n    Sin datos de camiones\n  </div>\n  <div ng-repeat=\"(id, c) in camiones\" style=\"padding: 6px 0; border-bottom: 1px dotted #e0e0e0; display: flex; justify-content: space-between; align-items: center;\">\n    <span><strong>Camión #{{c.id}}</strong></span>\n    <span ng-if=\"c.libre\" style=\"color: #1565c0; font-weight: bold;\">● Disponible</span>\n    <span ng-if=\"!c.libre\" style=\"color: #e65100; font-weight: bold;\">● Ocupado</span>\n  </div>\n</div>\n<script>\n(function(scope) {\n  scope.camiones = {};\n  scope.contar = function(obj) { return Object.keys(obj || {}).length; };\n  scope.$watch('msg', function(msg) {\n    if (msg && msg.payload && msg.payload.id !== undefined) {\n      scope.camiones[msg.payload.id] = msg.payload;\n    }\n  });\n})(scope);\n</script>",
