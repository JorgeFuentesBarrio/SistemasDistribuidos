    {
        "id": "func_multi_cos",
        "type": "function",
        "z": "tab_layout_split_final",
        "name": "Procesar Cosechadora",
        "func": "let d = msg.payload;\n\nif (typeof d === \"string\") {\n    try {\n        d = JSON.parse(d);\n    } catch (e) {\n        return null;\n    }\n}\n\nif (!d || d.lat === undefined || d.lon === undefined) {\n    return null;\n}\n\nlet id = d.id;\nlet lat = Number(d.lat);\nlet lon = Number(d.lon);\nlet carga = Number(d.carga) || 0;\nlet alerta = (Number(d.solicita_descarga) === 1 || carga >= 80);\n\nlet msgMapa = {\n    payload: {\n        name: \"Cosechadora \" + id,\n        lat: lat,\n        lon: lon,\n        icon: \"circle\",\n        iconColor: alerta ? \"red\" : \"green\",\n        layer: \"Cosechadoras\",\n        tooltip: \"Cosechadora \" + id + \" | Tolva: \" + carga + \"%\" + (alerta ? \" (VACIADO)\" : \"\")\n    }\n};\n\nlet msgCard = {\n    payload: {\n        id: id,\n        lat: lat,\n        lon: lon,\n        carga: carga,\n        alerta: alerta\n    }\n};\n\nreturn [msgMapa, msgCard];",
        "outputs": 2,
        "x": 570,
        "y": 280,
        "wires": [
            [
                "nodo_worldmap_engine_multi"
            ],
            [
                "ui_card_cosechadoras_multi"
            ]
        ]
    },
